# ---- SEO & legal pages ----
# Search Console / Bing verification (optional – the public/google*.html file also verifies Google)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Shown on Terms / Privacy / Refund pages and invoices
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_PHONE=
GRIEVANCE_OFFICER=
LEGAL_CITY=

# ---- Branding (used in report text) ----
BRAND_NAME="mynumerologist.com"
EXPERT_NAME="[Expert Name]"

# ---- Narrative writer ----
# anthropic | openai | template  (template = offline writer from the knowledge base, no API key needed)
LLM_PROVIDER=template
# Model id from your provider's model list, e.g. a current Claude Sonnet model
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 0.4–0.6 (values outside are clamped)
LLM_TEMPERATURE=0.5
LLM_TIMEOUT_MS=45000
# Optional proxy / gateway base URL
LLM_BASE_URL=
# Signature Analysis Agent (admin): needs a VISION-capable model. Blank = use LLM_MODEL.
# Without an API key the tool still works with the offline rule-based analyst.
SIGNATURE_LLM_MODEL=
# Business Compatibility Agent (admin). Blank = use LLM_MODEL. Without a key the built-in analyst writes the report.
BUSINESS_LLM_MODEL=

# ---- PDF ----
EXPERT_CONTACT="[Phone] · [Email] · [City]"
BRAND_WEBSITE=
BOOKING_URL=https://example.com/book
# Path to a Chromium binary (needed on serverless hosts such as Vercel)
PDF_CHROMIUM_PATH=

# ---- Database (Phase 5) ----
# Supabase: Project settings → Database → Connection string (use the pooler URL, port 6543, for serverless)
DATABASE_URL=postgres://user:password@host:5432/postgres
DATABASE_POOL_MAX=5
# 32 random bytes, base64:  openssl rand -base64 32   (keep it safe – data cannot be decrypted without it)
ENCRYPTION_KEY=
# Set only while rotating keys
ENCRYPTION_KEY_PREVIOUS=
# Public base URL used in share links
APP_URL=http://localhost:3000

# ---- Login (Phase 6) ----
# Comma-separated emails that become Super Admin when they sign in
SUPER_ADMIN_EMAILS=you@yourbrand.in
# Email OTP via Resend (https://resend.com) – verify your sending domain first
RESEND_API_KEY=
EMAIL_FROM="mynumerologist.com <login@yourbrand.in>"
# Mobile OTP via MSG91 – needs a DLT-approved template containing ##OTP##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Google sign-in: Google Cloud Console → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra secret mixed into OTP hashes (defaults to ENCRYPTION_KEY)
OTP_PEPPER=
# Development only: show the OTP on the login screen (ignored in production)
AUTH_DEV_SHOW_OTP=0
# Development/test only: sign every request in as this account (ignored in production)
AUTH_DEV_BYPASS_EMAIL=

# ---- Payments (Cashfree only) ----
# Cashfree Payments: Dashboard → Developers → API Keys. Put real keys ONLY in .env.local / your hosting env – never commit them.
# CASHFREE_ENV: production | sandbox (blank = detected from the key: "_prod_" in the secret = production).
# Production keys only work from a domain whitelisted in the Cashfree dashboard – use sandbox keys on localhost.
# Without keys a development server shows a "Simulate payment" test button; a production server refuses orders.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=
# Cashfree webhook: Dashboard → Developers → Webhooks → {APP_URL}/api/billing/cashfree/webhook (needs an https APP_URL)

# ---- GST invoice defaults (editable later in Admin → Invoice settings) ----
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=Rajasthan
SELLER_STATE_CODE=08
SELLER_SAC=999799
SELLER_EMAIL=
SELLER_PHONE=
INVOICE_PREFIX=INV
